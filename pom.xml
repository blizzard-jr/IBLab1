<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
  <groupId>ru.itmo</groupId><artifactId>secure-rest-api</artifactId><version>1.0.0</version>
  <properties><java.version>21</java.version><tomcat.version>11.0.27</tomcat.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>com.github.spotbugs</groupId><artifactId>spotbugs-maven-plugin</artifactId><version>4.9.8.5</version>
      <configuration><effort>Max</effort><threshold>Low</threshold><xmlOutput>true</xmlOutput><htmlOutput>true</htmlOutput><excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
        <plugins><plugin><groupId>com.h3xstream.findsecbugs</groupId><artifactId>findsecbugs-plugin</artifactId><version>1.14.0</version></plugin></plugins>
      </configuration>
    </plugin>
  </plugins></build>
  <profiles><profile><id>sca</id><build><plugins>
    <plugin><groupId>org.owasp</groupId><artifactId>dependency-check-maven</artifactId><version>13.0.0</version>
      <configuration><failBuildOnCVSS>7</failBuildOnCVSS><failOnError>true</failOnError>
        <!-- NVD remains enabled. Optional authenticated Sonatype source is not used. -->
        <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
        <!-- Keep the large NVD database outside ~/.m2 so CI can cache it separately. -->
        <dataDirectory>${user.home}/.cache/dependency-check</dataDirectory>
        <formats><format>HTML</format><format>JSON</format></formats>
        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
      </configuration>
    </plugin>
  </plugins></build></profile></profiles>
</project>
